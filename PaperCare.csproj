<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MoniPaper</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>MoniPaper</AssemblyTitle>
    <Product>MoniPaper</Product>
    <ApplicationIcon>Assets\papercare.ico</ApplicationIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>DCspirit-23</Authors>
    <Copyright>Copyright (c) 2026 DCspirit-23</Copyright>
    <RepositoryUrl>https://github.com/DCspirit-23/Paper-Care</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\papercare.ico" />
    <Resource Include="Assets\papercare.png" />
  </ItemGroup>
</Project>
