<Window x:Class="PaperCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="纸感护眼 PaperCare"
        Width="920" Height="680" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F7F1E5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#214F40" />
        <SolidColorBrush x:Key="MutedInk" Color="#60756A" />
        <SolidColorBrush x:Key="Card" Color="#FFFDF8" />
        <SolidColorBrush x:Key="Line" Color="#E5DCCB" />
        <SolidColorBrush x:Key="WarmLine" Color="#D8C7A8" />
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#F1E8D6" />
            <Setter Property="BorderBrush" Value="#D7C6A8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5F0E8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextureCard" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#FAF7EF" />
            <Setter Property="BorderBrush" Value="#E5DCCB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Margin" Value="0,0,9,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F6F1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValueSlider" TargetType="Slider">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,12,0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="LabelCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,24,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="纸感护眼" FontSize="29" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="PaperCare · 给屏幕铺一层轻柔的纸张质感" Style="{StaticResource Caption}" Margin="1,3,0,0" />
                </StackPanel>
                <Button Content="退出程序" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ExitButton_OnClick" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="EnabledCheckBox" Grid.Column="0" Content="启用桌面覆盖" Style="{StaticResource LabelCheckBox}" Checked="EnabledCheckBox_OnChanged" Unchecked="EnabledCheckBox_OnChanged" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="覆盖已关闭" Foreground="{StaticResource MutedInk}" VerticalAlignment="Center" Margin="16,0,10,0" />
                    <Button x:Name="PauseButton" Grid.Column="2" Content="暂停 10 分钟" Style="{StaticResource ActionButton}" Click="PauseButton_OnClick" />
                    <Button x:Name="ResumeButton" Grid.Column="3" Content="恢复" Style="{StaticResource ActionButton}" Click="ResumeButton_OnClick" IsEnabled="False" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,7,14">
                    <StackPanel>
                        <TextBlock Text="选择纸张" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="纹理会平铺到每个屏幕，强度可单独调节。" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TextureCard0" Grid.Row="0" Grid.Column="0" Tag="0" Style="{StaticResource TextureCard}" Click="TextureCard_OnClick">
                                <StackPanel><Border x:Name="TexturePreview0" Height="57" CornerRadius="9"/><TextBlock Text="细纹纸" Margin="0,8,0,1" FontWeight="SemiBold"/><TextBlock Text="均匀细腻" Style="{StaticResource Caption}"/></StackPanel>
                            </Button>
                            <Button x:Name="TextureCard1" Grid.Row="0" Grid.Column="1" Tag="1" Style="{StaticResource TextureCard}" Click="TextureCard_OnClick">
                                <StackPanel><Border x:Name="TexturePreview1" Height="57" CornerRadius="9"/><TextBlock Text="棉麻纸" Margin="0,8,0,1" FontWeight="SemiBold"/><TextBlock Text="有轻微纤维感" Style="{StaticResource Caption}"/></StackPanel>
                            </Button>
                            <Button x:Name="TextureCard2" Grid.Row="1" Grid.Column="0" Tag="2" Style="{StaticResource TextureCard}" Click="TextureCard_OnClick">
                                <StackPanel><Border x:Name="TexturePreview2" Height="57" CornerRadius="9"/><TextBlock Text="柔雾纸" Margin="0,8,0,1" FontWeight="SemiBold"/><TextBlock Text="平滑柔和" Style="{StaticResource Caption}"/></StackPanel>
                            </Button>
                            <Button x:Name="TextureCard3" Grid.Row="1" Grid.Column="1" Tag="3" Style="{StaticResource TextureCard}" Click="TextureCard_OnClick">
                                <StackPanel><Border x:Name="TexturePreview3" Height="57" CornerRadius="9"/><TextBlock Text="夜读纸" Margin="0,8,0,1" FontWeight="SemiBold"/><TextBlock Text="沉静低亮" Style="{StaticResource Caption}"/></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="7,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="阅读预览" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="与桌面覆盖使用相同纹理算法" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid x:Name="ReadingPreview" Height="192" Margin="0,12,0,0">
                            <Border Background="#FFFCF6" CornerRadius="13" BorderBrush="#D8C7A8" BorderThickness="1" />
                            <StackPanel Margin="18" VerticalAlignment="Center">
                                <TextBlock Text="一页安静的阅读时间" FontSize="23" FontWeight="SemiBold" Foreground="#345445" />
                                <TextBlock Text="让内容保持清晰，让背景退到刚刚好的位置。" FontSize="13" Foreground="#60756A" Margin="0,9,0,0" TextWrapping="Wrap" />
                                <Border Height="1" Background="#D8C7A8" Margin="0,17,0,12" />
                                <TextBlock Text="纸感护眼会在屏幕上叠加程序生成的纸张纹理，不修改系统亮度或色彩设置。" FontSize="12" Foreground="#60756A" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="ReadingTextureOverlay" CornerRadius="13" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="效果调节" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="三项设置彼此独立，数值越高，叠加效果越明显。" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="纸张强度" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        <Slider x:Name="IntensitySlider" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="IntensitySlider_OnChanged" />
                        <TextBlock x:Name="IntensityValue" Grid.Row="0" Grid.Column="2" Text="30%" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="暖色" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        <Slider x:Name="WarmthSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="0" Maximum="100" TickFrequency="10" ValueChanged="WarmthSlider_OnChanged" />
                        <TextBlock x:Name="WarmthValue" Grid.Row="1" Grid.Column="2" Text="10%" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="压暗" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        <Slider x:Name="DimSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="0" Maximum="50" TickFrequency="5" ValueChanged="DimSlider_OnChanged" />
                        <TextBlock x:Name="DimValue" Grid.Row="2" Grid.Column="2" Text="0%" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,7,14">
                    <StackPanel>
                        <TextBlock Text="覆盖屏幕" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="显示器变化后会自动重新建立覆盖层。" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                        <RadioButton x:Name="AllScreensRadio" Content="所有显示器" GroupName="Screens" Foreground="{StaticResource Ink}" Margin="0,2,0,8" Checked="AllScreensRadio_OnChecked" />
                        <RadioButton x:Name="PrimaryScreenRadio" Content="仅主屏幕" GroupName="Screens" Foreground="{StaticResource Ink}" Checked="PrimaryScreenRadio_OnChecked" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="7,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="休息提醒" Style="{StaticResource SectionTitle}" />
                            <CheckBox x:Name="ReminderCheckBox" Content="开启" Style="{StaticResource LabelCheckBox}" HorizontalAlignment="Right" Checked="ReminderCheckBox_OnChanged" Unchecked="ReminderCheckBox_OnChanged" />
                        </Grid>
                        <TextBlock Text="只在开启提醒后开始计时，通知不会抢占当前窗口。" Style="{StaticResource Caption}" Margin="0,0,0,9" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="间隔" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            <ComboBox x:Name="BreakComboBox" Width="96" Margin="12,0,0,0" SelectionChanged="BreakComboBox_OnChanged">
                                <ComboBoxItem Tag="20" Content="20 分钟" />
                                <ComboBoxItem Tag="30" Content="30 分钟" />
                                <ComboBoxItem Tag="45" Content="45 分钟" />
                                <ComboBoxItem Tag="60" Content="60 分钟" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="5" Background="#EEF5EE" BorderBrush="#D6E7D9" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,2">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="快捷键与托盘" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Ctrl + Alt + P：开关覆盖　　Ctrl + Alt + ↑ / ↓：调节纸张强度　　关闭窗口后可从系统托盘重新打开。" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="HotkeyWarning" Foreground="#A85A36" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="SettingsWarning" Foreground="#A85A36" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
