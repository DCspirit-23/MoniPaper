<Window x:Class="PaperCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoniPaper"
        Icon="pack://application:,,,/Assets/papercare.ico"
        Width="460" Height="560" MinWidth="400" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6F3"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F7F6F3" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#242A27" />
        <SolidColorBrush x:Key="MutedBrush" Color="#66706A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E6E8E3" />
        <SolidColorBrush x:Key="GreenBrush" Color="#214F40" />
        <SolidColorBrush x:Key="PaleGreenBrush" Color="#EDF3EC" />
        <SolidColorBrush x:Key="TrackBrush" Color="#DCE2DD" />

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F1F5F1" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#BFCFC4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#E3EEE5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style x:Key="TextureChoice" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinHeight" Value="66" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChoiceChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="Background" Value="#F3F7F3" />
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="#BFCFC4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="Background" Value="#E3EEE5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                <Setter TargetName="ChoiceChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="26" Margin="1">
                            <Border x:Name="SwitchTrack" Background="#D8DFDA" BorderBrush="#C7D0C9" BorderThickness="1" CornerRadius="13" />
                            <Ellipse x:Name="SwitchThumb" Width="20" Height="20" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource GreenBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#91AB9B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.45" />
                                <Setter TargetName="SwitchThumb" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="SliderRepeatButtonTemplate" TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}" Height="4" VerticalAlignment="Center" CornerRadius="2" />
        </ControlTemplate>
        <ControlTemplate x:Key="SliderThumbTemplate" TargetType="Thumb">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource GreenBrush}" BorderThickness="2" CornerRadius="8" />
        </ControlTemplate>
        <Style x:Key="PaperSlider" TargetType="Slider">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="32" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Focusable="False"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="{TemplateBinding Foreground}"
                                                  BorderThickness="0"
                                                  Template="{StaticResource SliderRepeatButtonTemplate}"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="{TemplateBinding Background}"
                                                  BorderThickness="0"
                                                  Template="{StaticResource SliderRepeatButtonTemplate}"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Template="{StaticResource SliderThumbTemplate}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <ControlTemplate x:Key="ScrollBarRepeatButtonTemplate" TargetType="RepeatButton">
            <Border Background="Transparent" />
        </ControlTemplate>
        <ControlTemplate x:Key="ScrollBarThumbTemplate" TargetType="Thumb">
            <Grid Background="Transparent">
                <Border x:Name="ScrollThumbVisual" Width="6" HorizontalAlignment="Center" Background="#B9C2BC" CornerRadius="3" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ScrollThumbVisual" Property="Background" Value="#9EAAA2" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ScrollThumbVisual" Property="Background" Value="#84968B" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="MoniPaperVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="12" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="NaN"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Template="{StaticResource ScrollBarRepeatButtonTemplate}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Template="{StaticResource ScrollBarRepeatButtonTemplate}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Height="60" MinHeight="60" Width="12" Template="{StaticResource ScrollBarThumbTemplate}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentChrome" Property="Background" Value="{StaticResource PaleGreenBrush}" />
                                <Setter TargetName="SegmentChrome" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentChrome" Property="BorderBrush" Value="#BFCFC4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SegmentChrome" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                <Setter TargetName="SegmentChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegmentChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid x:Name="MainPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/Assets/papercare.png" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="MoniPaper" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderStatus" Text="未开启" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                </StackPanel>
                <ToggleButton x:Name="EnabledToggle" Grid.Column="2" Style="{StaticResource SwitchStyle}"
                              AutomationProperties.Name="启用桌面覆盖"
                              ToolTip="启用桌面覆盖"
                              Checked="EnabledToggle_OnChanged" Unchecked="EnabledToggle_OnChanged" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource MoniPaperVerticalScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="20,0,20,10">
                    <Grid x:Name="ReadingPreviewFrame" Height="154" Margin="0,0,0,18">
                        <Border Background="#E5DFD5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" />
                        <StackPanel Margin="16,13" VerticalAlignment="Center">
                            <TextBlock Text="效果预览" Style="{StaticResource SecondaryText}" />
                            <TextBlock Text="这是一段示例文字。" Foreground="#354B40" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
                            <TextBlock Text="调节强度，找到舒服的纸感。" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border x:Name="ReadingTextureOverlay" CornerRadius="10" IsHitTestVisible="False" />
                    </Grid>

                    <TextBlock Text="纸张" Style="{StaticResource GroupLabel}" Margin="0,0,0,8" />
                    <UniformGrid Columns="4" Margin="-2,0,-2,0">
                        <Button x:Name="TextureCard0" Tag="0" Style="{StaticResource TextureChoice}" Click="TextureCard_OnClick" AutomationProperties.Name="选择细纹纸">
                            <StackPanel>
                                <Border x:Name="TexturePreview0" Height="32" CornerRadius="5" />
                                <Grid Margin="1,5,1,0"><TextBlock Text="细纹纸" FontSize="12" /><TextBlock x:Name="TextureCheck0" Text="✓" Visibility="Collapsed" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TextureCard1" Tag="1" Style="{StaticResource TextureChoice}" Click="TextureCard_OnClick" AutomationProperties.Name="选择棉麻纸">
                            <StackPanel>
                                <Border x:Name="TexturePreview1" Height="32" CornerRadius="5" />
                                <Grid Margin="1,5,1,0"><TextBlock Text="棉麻纸" FontSize="12" /><TextBlock x:Name="TextureCheck1" Text="✓" Visibility="Collapsed" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TextureCard2" Tag="2" Style="{StaticResource TextureChoice}" Click="TextureCard_OnClick" AutomationProperties.Name="选择柔雾纸">
                            <StackPanel>
                                <Border x:Name="TexturePreview2" Height="32" CornerRadius="5" />
                                <Grid Margin="1,5,1,0"><TextBlock Text="柔雾纸" FontSize="12" /><TextBlock x:Name="TextureCheck2" Text="✓" Visibility="Collapsed" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TextureCard3" Tag="3" Style="{StaticResource TextureChoice}" Click="TextureCard_OnClick" AutomationProperties.Name="选择夜读纸">
                            <StackPanel>
                                <Border x:Name="TexturePreview3" Height="32" CornerRadius="5" />
                                <Grid Margin="1,5,1,0"><TextBlock Text="夜读纸" FontSize="12" /><TextBlock x:Name="TextureCheck3" Text="✓" Visibility="Collapsed" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IntensityLabel" Grid.Column="0" Text="纸感强度" Style="{StaticResource GroupLabel}" />
                        <TextBlock x:Name="IntensityValue" Grid.Column="1" Text="30%" Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="SemiBold" MinWidth="42" TextAlignment="Right" />
                    </Grid>
                    <Slider x:Name="IntensitySlider" AutomationProperties.LabeledBy="{Binding ElementName=IntensityLabel}" AutomationProperties.Name="纸感强度" Style="{StaticResource PaperSlider}" Minimum="0" Maximum="100" TickFrequency="10" ValueChanged="IntensitySlider_OnChanged" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,9,20,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="MainWarningPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,7">
                        <TextBlock x:Name="HotkeyWarning" Foreground="#9B5039" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="SettingsWarning" Foreground="#9B5039" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PauseActionButton" Grid.Column="0" Content="暂停 10 分钟" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Click="PauseActionButton_OnClick" AutomationProperties.Name="暂停或恢复护眼" />
                        <Button x:Name="MoreSettingsButton" Grid.Column="1" Content="更多设置  ›" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="MoreSettingsButton_OnClick" AutomationProperties.Name="打开更多设置" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,13,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="‹  返回" Style="{StaticResource QuietButton}" Click="BackButton_OnClick" AutomationProperties.Name="返回主界面" />
                <TextBlock Grid.Column="1" Text="更多设置" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>

            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource MoniPaperVerticalScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="20,0,20,16">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="WarmthLabel" Grid.Column="0" Text="暖色" Style="{StaticResource GroupLabel}" />
                        <TextBlock x:Name="WarmthValue" Grid.Column="1" Text="10%" Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="SemiBold" MinWidth="42" TextAlignment="Right" />
                    </Grid>
                    <Slider x:Name="WarmthSlider" AutomationProperties.LabeledBy="{Binding ElementName=WarmthLabel}" AutomationProperties.Name="暖色" Style="{StaticResource PaperSlider}" Minimum="0" Maximum="100" TickFrequency="10" ValueChanged="WarmthSlider_OnChanged" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DimLabel" Grid.Column="0" Text="压暗" Style="{StaticResource GroupLabel}" />
                        <TextBlock x:Name="DimValue" Grid.Column="1" Text="0%" Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="SemiBold" MinWidth="42" TextAlignment="Right" />
                    </Grid>
                    <Slider x:Name="DimSlider" AutomationProperties.LabeledBy="{Binding ElementName=DimLabel}" AutomationProperties.Name="压暗" Style="{StaticResource PaperSlider}" Minimum="0" Maximum="50" TickFrequency="5" ValueChanged="DimSlider_OnChanged" />

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="覆盖范围" Style="{StaticResource GroupLabel}" Margin="0,0,0,9" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <RadioButton x:Name="AllScreensRadio" Grid.Column="0" Content="所有显示器" GroupName="Screens" Style="{StaticResource SegmentRadio}" Margin="0,0,4,0" Checked="AllScreensRadio_OnChecked" />
                                <RadioButton x:Name="PrimaryScreenRadio" Grid.Column="1" Content="仅主屏幕" GroupName="Screens" Style="{StaticResource SegmentRadio}" Margin="4,0,0,0" Checked="PrimaryScreenRadio_OnChecked" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,15,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="休息提醒" Style="{StaticResource GroupLabel}" />
                                <ToggleButton x:Name="ReminderToggle" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" AutomationProperties.Name="开启休息提醒" Checked="ReminderToggle_OnChanged" Unchecked="ReminderToggle_OnChanged" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="提醒间隔" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <ComboBox x:Name="BreakComboBox" Grid.Column="1" Width="112" Style="{StaticResource SettingCombo}" AutomationProperties.Name="休息提醒间隔" SelectionChanged="BreakComboBox_OnChanged">
                                    <ComboBoxItem Tag="20" Content="20 分钟" />
                                    <ComboBoxItem Tag="30" Content="30 分钟" />
                                    <ComboBoxItem Tag="45" Content="45 分钟" />
                                    <ComboBoxItem Tag="60" Content="60 分钟" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,15,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="快捷键" Style="{StaticResource GroupLabel}" />
                                <Button x:Name="CustomizeShortcutsButton" Content="自定义  ›" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="CustomizeShortcutsButton_OnClick" AutomationProperties.Name="自定义快捷键" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="呼出主面板" Style="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="ShowPanelShortcutText" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Right" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="开关覆盖" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                <TextBlock x:Name="ToggleOverlayShortcutText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Right" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="纸感强度" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                <TextBlock x:Name="IntensityShortcutText" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="ShortcutApplyStatus" Foreground="{StaticResource GreenBrush}" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="关闭窗口时" Style="{StaticResource GroupLabel}" Margin="0,0,0,9" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <RadioButton x:Name="CloseToTrayRadio" Grid.Column="0" Content="最小化到托盘" GroupName="CloseBehavior" Style="{StaticResource SegmentRadio}" Margin="0,0,4,0" Checked="CloseToTrayRadio_OnChecked" />
                                <RadioButton x:Name="CloseToExitRadio" Grid.Column="1" Content="退出程序" GroupName="CloseBehavior" Style="{StaticResource SegmentRadio}" Margin="4,0,0,0" Checked="CloseToExitRadio_OnChecked" />
                            </Grid>
                            <TextBlock x:Name="CloseBehaviorHint" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,9,20,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="SettingsWarningPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,7">
                        <TextBlock x:Name="SettingsPageHotkeyWarning" Foreground="#9B5039" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="SettingsPageWarning" Foreground="#9B5039" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="SettingsExitButton" Grid.Row="1" Content="退出程序" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Click="ExitButton_OnClick" AutomationProperties.Name="退出程序" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ShortcutEditorPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,13,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ShortcutEditorBackButton" Grid.Column="0" Content="‹  返回" Style="{StaticResource QuietButton}" Click="ShortcutEditorBackButton_OnClick" AutomationProperties.Name="返回更多设置" />
                <TextBlock Grid.Column="1" Text="自定义快捷键" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>

            <ScrollViewer x:Name="ShortcutEditorScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource MoniPaperVerticalScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="20,0,20,16">
                    <TextBlock Text="点击组合键，再按下新的键位。至少包含 Ctrl、Alt 或 Shift。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,15" />

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="面板与覆盖" Style="{StaticResource GroupLabel}" Margin="0,0,0,9" />
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="呼出主面板" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <Button x:Name="RecordShowPanelButton" Grid.Column="1" Content="Ctrl + Alt + O" Style="{StaticResource ActionButton}" MinWidth="154" MaxWidth="210" Click="RecordShortcutButton_OnClick" Tag="ShowPanel" AutomationProperties.Name="录制呼出主面板快捷键" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开关覆盖" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <Button x:Name="RecordToggleOverlayButton" Grid.Column="1" Content="Ctrl + Alt + P" Style="{StaticResource ActionButton}" MinWidth="154" MaxWidth="210" Click="RecordShortcutButton_OnClick" Tag="ToggleOverlay" AutomationProperties.Name="录制开关覆盖快捷键" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="纸感强度" Style="{StaticResource GroupLabel}" Margin="0,0,0,9" />
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="增加" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <Button x:Name="RecordIncreaseIntensityButton" Grid.Column="1" Content="Ctrl + Alt + ↑" Style="{StaticResource ActionButton}" MinWidth="154" MaxWidth="210" Click="RecordShortcutButton_OnClick" Tag="IncreaseIntensity" AutomationProperties.Name="录制增加强度快捷键" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="减少" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <Button x:Name="RecordDecreaseIntensityButton" Grid.Column="1" Content="Ctrl + Alt + ↓" Style="{StaticResource ActionButton}" MinWidth="154" MaxWidth="210" Click="RecordShortcutButton_OnClick" Tag="DecreaseIntensity" AutomationProperties.Name="录制减少强度快捷键" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Esc 取消录制；Tab 可继续移动焦点。按应用后新快捷键才会生效。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,18,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,9,20,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="ShortcutEditorMessagePanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,7">
                        <TextBlock x:Name="ShortcutEditorError" Foreground="#9B5039" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="ShortcutEditorSuccess" Foreground="{StaticResource GreenBrush}" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="RestoreDefaultShortcutsButton" Grid.Column="0" Content="恢复默认" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="RestoreDefaultShortcutsButton_OnClick" AutomationProperties.Name="恢复默认快捷键" />
                        <Button x:Name="CancelShortcutButton" Grid.Column="1" Content="取消" Style="{StaticResource QuietButton}" Click="CancelShortcutButton_OnClick" AutomationProperties.Name="取消快捷键编辑" />
                        <Button x:Name="ApplyShortcutsButton" Grid.Column="2" Content="应用" Style="{StaticResource ActionButton}" Click="ApplyShortcutsButton_OnClick" AutomationProperties.Name="应用快捷键" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
